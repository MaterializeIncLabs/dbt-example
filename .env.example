# Environment Variables for CI/CD
# Copy this file to .env for local testing (DO NOT commit .env to git)
# Set these as GitHub Secrets for CI/CD workflows

# ============================================================================
# Materialize Cloud Connection (Shared for QA and Production)
# ============================================================================
# Most Materialize Cloud users have a single instance and use database/schema/cluster
# namespacing for environment separation (qa_compute vs production_compute, etc.)
MATERIALIZE_HOST=your-instance.aws.materialize.cloud
MATERIALIZE_PORT=6875
MATERIALIZE_USER=your_user@example.com
MATERIALIZE_PASSWORD=your_password

# ============================================================================
# Optional: Separate QA and Production Instances (Self-Managed)
# ============================================================================
# If you have separate Materialize instances for QA and Production,
# uncomment and use these instead of the shared connection above:
#
# MATERIALIZE_QA_HOST=your-qa-instance.aws.materialize.cloud
# MATERIALIZE_QA_PORT=6875
# MATERIALIZE_QA_USER=your_user@example.com
# MATERIALIZE_QA_PASSWORD=your_qa_password
#
# MATERIALIZE_PROD_HOST=your-prod-instance.aws.materialize.cloud
# MATERIALIZE_PROD_PORT=6875
# MATERIALIZE_PROD_USER=your_user@example.com
# MATERIALIZE_PROD_PASSWORD=your_prod_password

# ============================================================================
# Optional: Slack Notifications
# ============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# Environment Separation Strategy
# ============================================================================
# Single Materialize Cloud instance with namespace separation:
#   Database: auction_team (team-specific)
#
#   QA Environment:
#     - Clusters: qa_sources, qa_compute, qa_sinks
#     - Schemas: qa_staging, qa_intermediate, qa_marts
#
#   Production Environment:
#     - Clusters: production_sources, production_compute, production_sinks
#     - Schemas: production_staging, production_intermediate, production_marts
#
# This approach allows multiple teams to share a Materialize Cloud instance
# while maintaining isolation between environments.

# ============================================================================
# Usage Instructions
# ============================================================================
# 1. For local testing with QA environment:
#    - Copy this file: cp .env.example .env
#    - Fill in your Materialize Cloud credentials
#    - Run: source .env && dbt run --profiles-dir . --profile materialize_auction_house --target qa
#
# 2. For GitHub Actions CI/CD:
#    - Go to: Settings > Secrets and variables > Actions
#    - Add each variable as a Repository Secret
#    - See docs/CI-CD-SETUP.md for detailed instructions
